# Required for Prisma Migrate, `npm run db:seed`, and the app database client.
# `prisma generate` and typecheck do not connect, and still run when this is unset.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/berlin_autoworks"

# Absolute origin used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Placeholders for later integrations. The app does not read these yet.
# AUTH_SECRET="replace-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"
# REDIS_URL="redis://127.0.0.1:6379"
# STRIPE_SECRET_KEY="replace-me"
# STRIPE_WEBHOOK_SECRET="replace-me"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="replace-me"
