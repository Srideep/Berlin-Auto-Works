# Required for Prisma Migrate, `npm run db:seed`, and the app database client.
# `prisma generate` and typecheck do not connect, and still run when this is unset.
#
# App runtime and seed. For Neon, use the pooled host (the hostname contains `-pooler`).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/berlin_autoworks"
# Prisma Migrate only. For Neon, use the direct host (same URL with `-pooler` removed).
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/berlin_autoworks"

# Absolute origin used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js. Leave unset to keep sign-in in preview mode. The build does not require it.
# AUTH_SECRET="replace-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"

# Redis rate limits and the BullMQ notification worker (`npm run worker`).
# Without it, rate limits stay in memory and email sends during the request.
# REDIS_URL="redis://127.0.0.1:6379"

# Resend. Without these, records are still saved and mail is skipped.
# RESEND_API_KEY="replace-me"
# EMAIL_FROM="Berlin AutoWorks <service@berlinautoworks.example>"

# Stripe Payment Element. Card data stays with Stripe.
# STRIPE_SECRET_KEY="replace-me"
# STRIPE_WEBHOOK_SECRET="replace-me"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="replace-me"

# S3-compatible uploads. S3_ENDPOINT is optional (set it for R2 or MinIO).
# S3_BUCKET="berlin-autoworks"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="replace-me"
# S3_SECRET_ACCESS_KEY="replace-me"
# S3_ENDPOINT="https://example.r2.cloudflarestorage.com"
